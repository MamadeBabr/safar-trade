# Application Environment: development, test, production
APP_ENV=development

# Server HTTP Port
PORT=8080

# PostgreSQL DSN connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/safar_trade?sslmode=disable

# Logging Level: debug, info, warn, error
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS) allowed origin (* or specific frontend domain)
CORS_ORIGIN=*

# Server HTTP request read/write timeout
SERVER_TIMEOUT=15s

# Graceful shutdown wait deadline
SHUTDOWN_PERIOD=10s

# Background Ingestion Scheduler (true / false)
ENABLE_INGESTION_SCHEDULER=true

# Periodic Ingestion Interval (e.g. 15m, 1h, 24h)
INGESTION_INTERVAL=1h

# Local file export path for Forex Factory JSON dump (set empty to disable)
FOREX_FACTORY_JSON_PATH=forexfactory.json

# Redis URL for caching latest candlestick snapshots
REDIS_URL=redis://localhost:6379/0

# Binance Collector Configuration
ENABLE_BINANCE_COLLECTOR=true
BINANCE_SPOT_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/stream
BINANCE_FLUSH_INTERVAL=3s
# Optional comma-separated symbols filter (leave empty to auto-discover all active USDT pairs)
BINANCE_SYMBOLS=

